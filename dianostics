<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>JSON Diagnostic</title>
<style>
body{font-family:monospace;background:#0d0a1a;color:#e8e0f0;padding:1rem;font-size:14px}
input[type=file]{margin-bottom:1rem;color:#e8e0f0}
#out{white-space:pre-wrap;word-break:break-all;background:#1a1028;padding:1rem;border-radius:8px;line-height:1.6}
.err{color:#e87e7e}
.ok{color:#7ee8b8}
</style>
</head>
<body>
<h2>Memory File Diagnostic Tool</h2>
<p>This will check your memories JSON file and tell you exactly where the problem is.</p>
<input type="file" id="f" accept=".json">
<div id="out">Choose your memories-2026-06-26.json file above.</div>
<script>
document.getElementById('f').onchange = function(e) {
  var file = e.target.files[0];
  var out = document.getElementById('out');
  out.innerHTML = "Reading file...";
  var r = new FileReader();
  r.onload = function(ev) {
    var text = ev.target.result;
    out.innerHTML = "File length: " + text.length + " characters<br><br>";
    try {
      var data = JSON.parse(text);
      out.innerHTML += '<span class="ok">✓ JSON parsed successfully! No corruption found.</span><br>';
      var mems = Array.isArray(data) ? data : (data.memories || []);
      out.innerHTML += "Memories found: " + mems.length + "<br>";
    } catch (err) {
      out.innerHTML += '<span class="err">✗ JSON Parse Error: ' + err.message + '</span><br><br>';
      var match = err.message.match(/position (\d+)/);
      if (match) {
        var pos = parseInt(match[1]);
        var start = Math.max(0, pos - 200);
        var end = Math.min(text.length, pos + 200);
        out.innerHTML += "<b>Context around error (position " + pos + "):</b><br>";
        out.innerHTML += "<div style='background:#2a1a3a;padding:0.5rem;margin-top:0.5rem'>";
        out.innerHTML += "...before: " + escapeHtml(text.slice(start, pos)) + "<br>";
        out.innerHTML += "<span style='background:red;color:white'>HERE →</span><br>";
        out.innerHTML += "after...: " + escapeHtml(text.slice(pos, end));
        out.innerHTML += "</div>";
        var beforeText = text.slice(0, pos);
        var lastTitleIdx = beforeText.lastIndexOf('"title"');
        if (lastTitleIdx > -1) {
          var titleSnippet = text.slice(lastTitleIdx, lastTitleIdx + 100);
          out.innerHTML += "<br><b>Nearest preceding 'title' field:</b><br>" + escapeHtml(titleSnippet);
        }
        var beforeSnippet = text.slice(Math.max(0,pos-5000), pos);
        var quoteCount = (beforeSnippet.match(/"/g) || []).length;
        out.innerHTML += "<br><br>Quote count in preceding 5000 chars: " + quoteCount + " (odd = currently inside a string)";
      }
    }
  };
  r.onerror = function() { out.innerHTML = '<span class="err">Could not read file.</span>'; };
  r.readAsText(file);
};
function escapeHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
</body>
</html>
